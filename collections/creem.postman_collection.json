            "url": { "raw": "{{baseUrl}}/licenses/validate", "host": ["{{baseUrl}}"], "path": ["licenses", "validate"] },
            "body": { "mode": "raw", "raw": "{\n  \"key\": \"<string>\",\n  \"instance_id\": \"<string>\"\n}", "options": { "raw": { "language": "json" } } }
          }
