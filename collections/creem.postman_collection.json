{
  "info": {
    "_postman_id": "c9f1e7a2-4b8d-4c2a-9e3f-1a2b3c4d5e6f",
    "name": "Creem API",
    "description": "REST API for Creem, a merchant-of-record payments platform for SaaS and AI startups. Authenticated with the x-api-key header. Base URL https://api.creem.io/v1 (test mode https://test-api.creem.io/v1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.creem.io/v1" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Create a product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"<string>\",\n  \"price\": 1000,\n  \"currency\": \"USD\",\n  \"billing_type\": \"recurring\",\n  \"billing_period\": \"every-month\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Retrieve a product",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products?product_id=<string>", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "product_id", "value": "<string>" }] }
          }
        },
        {
          "name": "List all products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products/search?page_number=1&page_size=10", "host": ["{{baseUrl}}"], "path": ["products", "search"], "query": [{ "key": "page_number", "value": "1" }, { "key": "page_size", "value": "10" }] }
          }
        }
      ]
    },
    {
      "name": "Checkouts",
      "item": [
        {
          "name": "Create a checkout session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/checkouts", "host": ["{{baseUrl}}"], "path": ["checkouts"] },
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": \"<string>\",\n  \"units\": 1,\n  \"discount_code\": \"<string>\",\n  \"customer\": { \"email\": \"<string>\" },\n  \"success_url\": \"<string>\",\n  \"metadata\": {}\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Retrieve a checkout session",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/checkouts?checkout_id=<string>", "host": ["{{baseUrl}}"], "path": ["checkouts"], "query": [{ "key": "checkout_id", "value": "<string>" }] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Retrieve a customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/customers?customer_id=<string>", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{ "key": "customer_id", "value": "<string>" }] }
          }
        },
        {
          "name": "Generate a customer billing portal link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/customers/billing", "host": ["{{baseUrl}}"], "path": ["customers", "billing"] },
            "body": { "mode": "raw", "raw": "{\n  \"customer_id\": \"<string>\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Retrieve a subscription",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/subscriptions?subscription_id=<string>", "host": ["{{baseUrl}}"], "path": ["subscriptions"], "query": [{ "key": "subscription_id", "value": "<string>" }] }
