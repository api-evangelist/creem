          }
        },
        {
          "name": "Delete a discount",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/discounts/:id/delete", "host": ["{{baseUrl}}"], "path": ["discounts", ":id", "delete"], "variable": [{ "key": "id", "value": "<string>" }] }
          }
        }
