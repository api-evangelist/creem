            "url": { "raw": "{{baseUrl}}/subscriptions/:id/upgrade", "host": ["{{baseUrl}}"], "path": ["subscriptions", ":id", "upgrade"], "variable": [{ "key": "id", "value": "<string>" }] },
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": \"<string>\",\n  \"update_behavior\": \"proration-charge-immediately\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Cancel a subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/subscriptions/:id/cancel", "host": ["{{baseUrl}}"], "path": ["subscriptions", ":id", "cancel"], "variable": [{ "key": "id", "value": "<string>" }] },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Pause a subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/subscriptions/:id/pause", "host": ["{{baseUrl}}"], "path": ["subscriptions", ":id", "pause"], "variable": [{ "key": "id", "value": "<string>" }] },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Resume a subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/subscriptions/:id/resume", "host": ["{{baseUrl}}"], "path": ["subscriptions", ":id", "resume"], "variable": [{ "key": "id", "value": "<string>" }] },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
