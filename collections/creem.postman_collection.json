          "name": "Create a discount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/discounts", "host": ["{{baseUrl}}"], "path": ["discounts"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"<string>\",\n  \"type\": \"percentage\",\n  \"percentage\": 20,\n  \"duration\": \"once\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
