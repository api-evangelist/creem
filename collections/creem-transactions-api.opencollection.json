{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creem Checkouts Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.creem.io/v1/transactions",
            "params": [
              {
                "name": "transaction_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a single transaction by its identifier."
        },
        {
          "info": {
            "name": "List all transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.creem.io/v1/transactions/search",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "product_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_number",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search and retrieve a paginated list of transactions, filtered by customer, product, and date range."
        }
      ]
    }
  ],
  "bundled": true
}