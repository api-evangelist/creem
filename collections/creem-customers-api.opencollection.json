{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creem Checkouts Customers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.creem.io/v1/customers",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a customer by id or email."
        },
        {
          "info": {
            "name": "Generate a customer billing portal link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.creem.io/v1/customers/billing",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a self-service customer billing portal link where the customer can manage subscriptions, invoices, and payment methods."
        }
      ]
    }
  ],
  "bundled": true
}